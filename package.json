{
  "name": "boda-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --exclude rules-tests/**",
    "test:rules": "firebase emulators:exec --only firestore --project demo-boda \"vitest run rules-tests/firestore.rules.test.ts\"",
    "preview": "vite preview",
    "tunnel": "npm run build && vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@tailwindcss/vite": "^4.3.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "firebase-tools": "^15.31.0",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
