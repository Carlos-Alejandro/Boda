rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /invitations/{invitationId} {
      // La URL de una invitación funciona como capacidad para leer únicamente
      // ese documento cuando la invitación está activa. Los documentos antiguos
      // sin isArchived también se consideran activos por compatibilidad.
      // Una invitación archivada nunca es legible desde el cliente público.
      allow get: if
        !('isArchived' in resource.data)
        || resource.data.isArchived == false;

      // Ningún cliente puede listar o enumerar la colección de invitaciones,
      // incluso si inició sesión con Firebase Auth.
      allow list: if false;

      // El RSVP ya no se escribe directamente desde el navegador. Create,
      // update y delete están prohibidos para todos los clientes; autenticarse
      // con Firebase Auth por sí solo no concede permisos administrativos.
      // Las modificaciones válidas pasan por Boda-API, que usa Firebase Admin
      // SDK en un entorno de servidor y no depende de estas reglas de cliente.
      allow create, update, delete: if false;
    }
  }
}
